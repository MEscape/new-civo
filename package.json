{
  "name": "civo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",

    "check": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run format:check && npm run i18n:check && npm run test",

    "test": "vitest run __tests__/src",
    "test:watch": "vitest",
    "test:architecture": "vitest run __tests__/architecture __tests__/eslint",

    "db:generate": "prisma contract emit",
    "db:migrate:check": "prisma migration check",
    "db:migrate:app": "prisma db migrate",
    "db:migrate:status": "prisma migration status",
    "db:migrate:auth": "tsx scripts/apply-auth-migration.ts",
    "db:migrate": "npm run db:migrate:app && npm run db:migrate:auth",
    "db:verify": "prisma db verify --strict",

    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",

    "i18n:check": "i18next-cli status"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/orm-family-sql": "8.0.0-rc.13",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.3",
    "happy-dom": "^20.14.5",
    "mapbox-gl": "^3.32.0",
    "neverthrow": "^8.2.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.8",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-check-file": "^2.8.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "i18next-cli": "^1.74.3",
    "prettier": "^3.4.0",
    "prisma": "8.0.0-rc.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "prisma": "$prisma",
    "@prisma/dev": {
      "valibot": "^1.5.0",
      "@hono/node-server": "^1.19.15",
      "hono": "^4.13.5",
      "lodash": "^4.18.0"
    }
  }
}
